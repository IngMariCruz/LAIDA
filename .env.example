# ==========================================
# LAIDA - Variables de Entorno
# ==========================================
# Copia este archivo como .env y completa los valores

# ==========================================
# BASE DE DATOS
# ==========================================

# Ruta de la base de datos SQLite (usada por el frontend/API)
DB_PATH=./bd/laida.db

# Ruta de la base de datos SQLite (usada por el bot Python)
BOT_DB_PATH=../bd/laida.db

# ==========================================
# BOT DE TELEGRAM
# ==========================================

# Directorio donde se guardan las conversaciones del bot
BOT_CONVERSATIONS_DIR=./conversations

# ⚠️ NOTA: Los tokens de Telegram y las API Keys de OpenAI
# se configuran POR BOT desde el Dashboard (Gestión de Bots).
# No se usan variables de entorno globales para eso.

# ==========================================
# NEXT.JS / FRONTEND
# ==========================================

# Entorno (development | production)
NODE_ENV=development

# Puerto del servidor web
PORT=3000

# ==========================================
# SEGURIDAD
# ==========================================

# Secret para firmar tokens de autenticación
# ⚠️ Cambiar por un valor aleatorio y seguro en producción
# JWT_SECRET=cambia-esto-por-un-string-aleatorio-largo

# ==========================================
# DOCKER (valores automáticos al usar docker-compose)
# ==========================================

# En Docker los paths se configuran automáticamente.
# Solo necesitas ajustarlos si corres los servicios por separado.
# DB_PATH=/app/data/laida.db
# BOT_DB_PATH=/app/data/laida.db
# BOT_CONVERSATIONS_DIR=/app/data/conversations
