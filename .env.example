# ==========================================
# LAIDA - Variables de Entorno
# ==========================================
# Copia este archivo como .env y completa los valores

# ==========================================
# BASE DE DATOS
# ==========================================

# Ruta de la base de datos SQLite
DB_PATH=./bd/laida.db

# Para el bot (Python)
BOT_DB_PATH=../bd/laida.db

# ==========================================
# BOT DE TELEGRAM
# ==========================================

# Directorio donde se guardan las conversaciones
BOT_CONVERSATIONS_DIR=./conversations

# ⚠️ NOTA: Los tokens de Telegram ahora se configuran por bot
# desde la interfaz web (Dashboard > Gestión de Bots)
# Ya NO uses TELEGRAM_TOKEN aquí

# ==========================================
# NEXT.JS / FRONTEND
# ==========================================

# Entorno (development | production)
NODE_ENV=development

# Puerto del servidor
PORT=3000

# ==========================================
# SEGURIDAD (TODO: Implementar)
# ==========================================

# Secret para JWT (implementar)
# JWT_SECRET=tu-secret-super-seguro-aqui

# Secret para cookies (implementar)
# COOKIE_SECRET=otro-secret-super-seguro

# ==========================================
# DOCKER
# ==========================================

# Para docker-compose, los paths son automáticos
# DB_PATH=/app/data/laida.db
# BOT_DB_PATH=/app/data/laida.db
# BOT_CONVERSATIONS_DIR=/app/data/conversations
